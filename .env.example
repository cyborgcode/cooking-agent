# Clé d'API Google Gemini — https://aistudio.google.com/apikey
# Facultative : sans elle, l'application bascule sur le planificateur local
# et reste pleinement utilisable.
GEMINI_API_KEY=

# Modèle utilisé pour la suggestion du jour (défaut : gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Clé d'API Tavily — https://app.tavily.com
# Facultative : elle active la recherche web (prix du marché en direct,
# recettes trouvées sur le web, contexte du jour). Sans elle, ces fonctions
# affichent les données intégrées et le reste de l'application est intact.
# L'hôte api.tavily.com doit être joignable depuis le serveur.
TAVILY_API_KEY=

# Point d'entrée de l'API Tavily. À ne renseigner que derrière une passerelle
# d'entreprise, ou pour diriger le client vers un service de test.
# TAVILY_API_URL=https://api.tavily.com/search
